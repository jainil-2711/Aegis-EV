# GreenCharge — environment example (SHARED)
# Copy to .env and adjust as needed. No value here is a required secret.

# --- Database ---------------------------------------------------------
# Local dev default (SQLite, zero setup). docker-compose.yml provides a
# real Postgres instance for the full-team run — point DATABASE_URL at it
# to match architecture.md's chosen production-shaped database.
DATABASE_URL=sqlite:///./greencharge.db
# DATABASE_URL=postgresql://greencharge:greencharge@localhost:5432/greencharge

# --- Demo / simulation -------------------------------------------------
GREENCHARGE_SEED=42
GREENCHARGE_TIMEZONE=Asia/Kolkata
GREENCHARGE_DEMO_DAY=2026-09-12
GREENCHARGE_NUM_EVS=40
GREENCHARGE_NUM_STATIONS=6
GREENCHARGE_NUM_CHARGERS=24
GREENCHARGE_SLOT_MINUTES=30
GREENCHARGE_HORIZON_HOURS=24

# --- CORS ---------------------------------------------------------------
GREENCHARGE_CORS_ORIGINS=http://localhost:5173

# --- Optional (Phase 6 / 11, never required for the demo) ---------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
